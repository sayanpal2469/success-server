# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4100
# Must be a replica set (Atlas is one by default) — transactions are used for admissions and payments.
MONGODB_URI=mongodb://127.0.0.1:27018/success_tutorials?replicaSet=rs0

# 64+ random characters each, different from each other:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret-123456
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me-refresh-secret-12345
ACCESS_TOKEN_TTL_MIN=15
ADMIN_REFRESH_TTL_DAYS=7
STUDENT_REFRESH_TTL_DAYS=180

# Comma separated origins allowed to call the API from a browser (admin panel, website, Expo web).
CORS_ORIGINS=http://localhost:5174,http://localhost:5175,http://localhost:5173,http://localhost:8081
# Number of proxies in front of the API (1 behind nginx / a load balancer) so rate limits see the real IP.
TRUST_PROXY=0
UPLOAD_DIR=./uploads
LOG_LEVEL=info

# Used only by `npm run seed`.
SEED_ADMIN_NAME=Srijit Saha
SEED_ADMIN_EMAIL=admin@successtutorials.in
SEED_ADMIN_PASSWORD=ChangeMe@2026

# Outgoing email (welcome emails, password-reset OTPs). For Gmail use an App Password (Google Account › Security › App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
MAIL_FROM_NAME=Success Tutorials
