{
  "name": "api",
  "private": true,
  "version": "1.0.0",
  "description": "Success Tutorials REST API (Express + MongoDB)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file=.env src/seed/seed.ts",
    "migrate:written-exams": "tsx --env-file=.env src/seed/migrate-written-exams.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.10.2",
    "multer": "2.4.0",
    "nodemailer": "^10.0.12",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server": "11.3.0",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "5.0.1"
  }
}
